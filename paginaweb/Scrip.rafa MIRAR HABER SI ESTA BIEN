// ==========================================
// 1. LÓGICA DEL MENÚ Y SESIÓN
// ==========================================
function actualizarMenu() {
    // Comprobamos la "llave" en la memoria del navegador
    const sesionIniciada = localStorage.getItem('usuarioLogueado') === 'true';

    const btnReservas = document.getElementById('menu-reservas');
    const btnPerfil = document.getElementById('menu-perfil');
    const btnLogin = document.getElementById('menu-login');

    if (sesionIniciada) {
        if(btnReservas) btnReservas.style.display = 'block';
        if(btnPerfil) btnPerfil.style.display = 'block';
        if(btnLogin) btnLogin.style.display = 'none';
    } else {
        if(btnReservas) btnReservas.style.display = 'none';
        if(btnPerfil) btnPerfil.style.display = 'none';
        if(btnLogin) btnLogin.style.display = 'block';
    }
}

// ==========================================
// 2. LÓGICA DEL CALENDARIO Y RESERVAS
// ==========================================
function configurarReservas() {
    // Elementos del formulario y modal
    const artistaSelect = document.getElementById("artista");
    const horaSelect = document.getElementById("hora");
    const fechaInputOculto = document.getElementById("fecha");
    
    const btnAbrirModal = document.getElementById('btn-abrir-calendario');
    const fondoModal = document.getElementById('fondo-modal');
    const btnCerrarModal = document.getElementById('btn-cerrar-calendario');
    
    const calendarioDias = document.getElementById("calendario-dias");
    const mesActualTexto = document.getElementById("mes-actual");
    const btnPrev = document.getElementById("mes-prev");
    const btnNext = document.getElementById("mes-next");

    // IMPORTANTE: Si no estamos en la página de reservas, detenemos esta función para evitar errores
    if (!artistaSelect || !btnAbrirModal || !fondoModal) return;

    // --- LÓGICA DE ABRIR/CERRAR MODAL ---
    btnAbrirModal.addEventListener('click', () => {
        fondoModal.style.display = 'flex';
    });

    btnCerrarModal.addEventListener('click', () => {
        fondoModal.style.display = 'none';
    });

    fondoModal.addEventListener('click', (e) => {
        if (e.target === fondoModal) {
            fondoModal.style.display = 'none';
        }
    });

    // --- VARIABLES DEL CALENDARIO ---
    let fechaMostrada = new Date(); 
    let fechaSeleccionada = null; 
    const meses = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];

    // --- SIMULADOR DE BASE DE DATOS (Horas y reservas) ---
    const horasDisponibles = ["10:00", "11:00", "12:00", "16:00", "17:00", "18:00", "19:00"];
    const reservasSimuladas = {
        "hugo": { "2026-04-20": ["10:00", "16:00"], "2026-04-21": ["11:00", "12:00"] },
        "sofia": { "2026-04-20": ["17:00", "18:00"] },
        "leo": { "2026-04-22": ["10:00", "11:00", "12:00"] },
        "carmen": {} 
    };

    // --- FUNCIÓN PARA DIBUJAR EL CALENDARIO ---
    function renderizarCalendario() {
        calendarioDias.innerHTML = "";
        
        const año = fechaMostrada.getFullYear();
        const mes = fechaMostrada.getMonth();
        
        mesActualTexto.textContent = `${meses[mes]} ${año}`;

        let primerDiaMes = new Date(año, mes, 1).getDay();
        primerDiaMes = primerDiaMes === 0 ? 6 : primerDiaMes - 1; // Ajustar para que Lunes sea el primer día

        const diasEnMes = new Date(año, mes + 1, 0).getDate();
        
        const hoy = new Date();
        hoy.setHours(0,0,0,0);

        // Espacios en blanco del principio del mes
        for (let i = 0; i < primerDiaMes; i++) {
            const espacio = document.createElement("div");
            calendarioDias.appendChild(espacio);
        }

        // Crear los días
        for (let i = 1; i <= diasEnMes; i++) {
            const diaDiv = document.createElement("div");
            diaDiv.classList.add("calendario-dia");
            diaDiv.textContent = i;

            const mesStr = (mes + 1).toString().padStart(2, '0');
            const diaStr = i.toString().padStart(2, '0');
            const fechaString = `${año}-${mesStr}-${diaStr}`;
            
            const fechaDeEsteDiv = new Date(año, mes, i);

            // Bloquear días pasados
            if (fechaDeEsteDiv < hoy) {
                diaDiv.classList.add("disabled");
            } else {
                if (fechaSeleccionada === fechaString) {
                    diaDiv.classList.add("seleccionado");
                }

                // Al hacer clic en un día válido
                diaDiv.addEventListener("click", () => {
                    document.querySelectorAll(".calendario-dia").forEach(el => el.classList.remove("seleccionado"));
                    diaDiv.classList.add("seleccionado");
                    
                    fechaSeleccionada = fechaString;
                    fechaInputOculto.value = fechaString; // Guardamos en el formulario
                    
                    // Actualizamos el botón rojo para que el cliente vea su fecha
                    btnAbrirModal.value = `📅 Día: ${diaStr}/${mesStr}/${año}`;
                    
                    // Cerramos el calendario automáticamente
                    fondoModal.style.display = 'none';

                    // Actualizamos las horas disponibles
                    actualizarHorario();
                });
            }

            calendarioDias.appendChild(diaDiv);
        }
    }

    // --- NAVEGACIÓN DEL CALENDARIO ---
    btnPrev.addEventListener("click", () => {
        fechaMostrada.setMonth(fechaMostrada.getMonth() - 1);
        renderizarCalendario();
    });

    btnNext.addEventListener("click", () => {
        fechaMostrada.setMonth(fechaMostrada.getMonth() + 1);
        renderizarCalendario();
    });

    // --- FUNCIÓN PARA BUSCAR LAS HORAS ---
    function actualizarHorario() {
        const artista = artistaSelect.value;
        const fecha = fechaInputOculto.value;

        horaSelect.innerHTML = '<option value="" disabled selected>3. Elige una hora</option>';

        if (!artista || !fecha) {
            horaSelect.innerHTML = '<option value="" disabled selected>Selecciona Artista y Fecha</option>';
            return;
        }

        const horasReservadas = (reservasSimuladas[artista] && reservasSimuladas[artista][fecha]) || [];

        horasDisponibles.forEach(hora => {
            const opcion = document.createElement("option");
            opcion.value = hora;
            
            if (horasReservadas.includes(hora)) {
                opcion.textContent = `${hora} - (Ocupado)`;
                opcion.disabled = true; 
                // En un select normal, el color no siempre se aplica en todos los navegadores,
                // pero le añadimos el texto "(Ocupado)" para que quede muy claro.
            } else {
                opcion.textContent = `${hora} - Libre`;
            }
            
            horaSelect.appendChild(opcion);
        });
    }

    artistaSelect.addEventListener("change", actualizarHorario);

    // Arrancamos el calendario por primera vez
    renderizarCalendario();
}

// ==========================================
// 3. INICIALIZACIÓN AL CARGAR LA PÁGINA
// ==========================================
document.addEventListener('DOMContentLoaded', () => {
    actualizarMenu();
    configurarReservas();
});

// Fuerza a la página a revisar la sesión al usar el botón "Atrás"
window.addEventListener('pageshow', function(event) {
    actualizarMenu();
});
